{
  "name": "expo-media-control-monorepo",
  "private": true,
  "description": "Monorepo for expo-media-control and expo-media-control-car",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:plugins": "npm run build:plugin --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "babel-preset-expo": "~57.0.13"
  }
}

{
  "name": "expo-media-control-car",
  "version": "1.0.0",
  "description": "Android Auto and Apple CarPlay support for expo-media-control: a browsable library, search and voice requests",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "android",
    "ios",
    "src",
    "build",
    "plugin/build",
    "plugin/src",
    "plugin/tsconfig.json",
    "app.plugin.js",
    "expo-module.config.json",
    "tsconfig.json",
    "*.md",
    "!**/__tests__",
    "!**/__mocks__"
  ],
  "scripts": {
    "build": "expo-module build",
    "build:plugin": "expo-module build plugin",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p plugin",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly && expo-module build plugin",
    "expo-module": "expo-module"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-media-control",
    "android-auto",
    "carplay",
    "car",
    "media-browser",
    "media-session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NO1225/expo-media-control.git",
    "directory": "packages/expo-media-control-car"
  },
  "bugs": {
    "url": "https://github.com/NO1225/expo-media-control/issues"
  },
  "author": "Juma <safartyjumah@gmail.com> (https://github.com/NO1225)",
  "license": "MIT",
  "homepage": "https://github.com/NO1225/expo-media-control/tree/main/packages/expo-media-control-car#readme",
  "devDependencies": {
    "@types/react": "~19.2.10",
    "expo": "~57.0.26",
    "expo-media-control": "^2.1.0",
    "expo-module-scripts": "^56.0.3",
    "react-native": "0.86.3"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-media-control": ">=2.1.0",
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "expo-module-scripts"
  }
}
